# --- Neon Postgres -----------------------------------------------------------
# Pooled connection for app queries; direct for migrations and the SSE poller.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- better-auth -------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ------------------------------------------------------------
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloudflare R2 -----------------------------------------------------------
# Needs an R2 API token scoped to the bucket, public access enabled, and a CORS
# rule allowing PUT/GET from your origin. Without these, uploads degrade
# gracefully and contenders fall back to initial portraits.
R2_ACCOUNT_ID=""
R2_BUCKET="versus-uploads"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# --- Vote integrity ----------------------------------------------------------
# openssl rand -hex 32 for each. VOTE_SECRET signs the anonymous voter cookie;
# IP_HASH_SALT salts the stored IP/UA hashes.
VOTE_SECRET=""
IP_HASH_SALT=""

# --- Cron --------------------------------------------------------------------
# Bearer token for /api/cron/lifecycle. openssl rand -hex 32
CRON_SECRET=""
